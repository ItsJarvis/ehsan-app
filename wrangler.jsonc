{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ehsan-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "24736140-d5ca-4e0d-9967-9d8cb83109ca","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5b0477b54dd6431bb488e156806e1eb1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
